{
  "name": "spv",
  "version": "0.1.0",
  "description": "SPV — Spatial Viewer: a static, browser-based 3D spatial transcriptomics viewer for .h5ad files",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:webkit": "SPV_WEBKIT=1 playwright test --project webkit",
    "check": "npm run typecheck && npm run lint && npm test",
    "budget": "node scripts/bundle_budget.mjs",
    "inspect": "python3 scripts/inspect_h5ad.py data/demo.h5ad"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "h5wasm": "0.10.3",
    "h5wasm-plugins": "0.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/three": "0.186.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
